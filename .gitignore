# Secret material
.env
.env.*
!.env.example
secrets/
*.secrets.*
*.pem
*.key
*.crt

# Runtime telemetry
data/**/live_*
data/**/*.log
output/**/*.json
logs/**
!logs/.gitkeep

# Environment profile runtime history
config/uploads/pending/*
config/uploads/accepted/*
config/uploads/rejected/*
config/backups/
config/versions/

# Local backup and temporary files
*.backup
*.before-*
*.tmp

# Test/runtime files
live-pipeline-tests.txt
test-results.txt

# Python
__pycache__/
*.pyc