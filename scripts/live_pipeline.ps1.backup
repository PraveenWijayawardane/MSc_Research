[CmdletBinding()]
param(
    [int]$IntervalSeconds = 30,
    [string]$ProjectRoot = "D:\MSc-Research\Healthcare-risk-engine",
    [string]$PythonPath = "D:\MSc-Research\venv\Scripts\python.exe",
    [string]$SshKey = "$env:USERPROFILE\.ssh\msc_lab_ed25519",
    [string]$MonitoringServer = "192.168.100.100",
    [string]$MonitoringUser = "vagrant",
    [string]$ZeekServer = "192.168.100.120",
    [string]$ZeekUser = "vagrant",
    [string]$ZeekRemoteLog = "/home/vagrant/conn.log",
    [string]$TargetIndex = "healthcare-risk-events-v2"
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"
$env:PYTHONUNBUFFERED = "1"

$DataDirectory = Join-Path $ProjectRoot "data"
$LogDirectory = Join-Path $ProjectRoot "logs"
$LocalZeekLog = Join-Path $DataDirectory "live_zeek_conn.log"
$TemporaryZeekLog = "$LocalZeekLog.tmp"
$PipelineLog = Join-Path $LogDirectory "live_pipeline.log"
$TunnelErrorLog = Join-Path $LogDirectory "indexer_tunnel_error.log"

New-Item -ItemType Directory -Force -Path $DataDirectory | Out-Null
New-Item -ItemType Directory -Force -Path $LogDirectory | Out-Null

function Write-PipelineLog {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message,
        [ValidateSet("INFO", "WARN", "ERROR")]
        [string]$Level = "INFO"
    )

    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $Line = "[$Timestamp] [$Level] $Message"
    Write-Host $Line
    Add-Content -Path $PipelineLog -Value $Line -Encoding UTF8
}

function Test-TcpPort {
    param(
        [string]$HostName,
        [int]$Port,
        [int]$TimeoutMilliseconds = 1000
    )

    $Client = New-Object System.Net.Sockets.TcpClient

    try {
        $AsyncResult = $Client.BeginConnect($HostName, $Port, $null, $null)
        $Connected = $AsyncResult.AsyncWaitHandle.WaitOne($TimeoutMilliseconds, $false)

        if (-not $Connected) {
            return $false
        }

        $Client.EndConnect($AsyncResult)
        return $true
    }
    catch {
        return $false
    }
    finally {
        $Client.Close()
    }
}

function Assert-RequiredFiles {
    $RequiredFiles = @(
        $PythonPath,
        $SshKey,
        (Join-Path $ProjectRoot ".env"),
        (Join-Path $ProjectRoot "src\wazuh_live_collector.py"),
        (Join-Path $ProjectRoot "src\zeek_log_parser.py"),
        (Join-Path $ProjectRoot "src\risk_engine.py"),
        (Join-Path $ProjectRoot "src\push_scored_events.py")
    )

    foreach ($RequiredFile in $RequiredFiles) {
        if (-not (Test-Path $RequiredFile)) {
            throw "Required file does not exist: $RequiredFile"
        }
    }

    foreach ($CommandName in @("ssh.exe", "scp.exe")) {
        if (-not (Get-Command $CommandName -ErrorAction SilentlyContinue)) {
            throw "$CommandName is not available in PATH"
        }
    }
}

function Start-IndexerTunnel {
    if (Test-TcpPort -HostName "127.0.0.1" -Port 9200) {
        Write-PipelineLog "OpenSearch tunnel is already available on localhost:9200."
        return
    }

    Write-PipelineLog "Starting SSH tunnel to ${MonitoringUser}@${MonitoringServer}..."
    Remove-Item $TunnelErrorLog -Force -ErrorAction SilentlyContinue

    $SshArguments = @(
        "-N",
        "-L", "9200:127.0.0.1:9200",
        "-i", $SshKey,
        "-o", "BatchMode=yes",
        "-o", "IdentitiesOnly=yes",
        "-o", "ExitOnForwardFailure=yes",
        "-o", "ServerAliveInterval=30",
        "-o", "ServerAliveCountMax=3",
        "-o", "StrictHostKeyChecking=accept-new",
        "${MonitoringUser}@${MonitoringServer}"
    )

    Start-Process `
        -FilePath "ssh.exe" `
        -ArgumentList $SshArguments `
        -WindowStyle Hidden `
        -RedirectStandardError $TunnelErrorLog | Out-Null

    $Deadline = (Get-Date).AddSeconds(12)

    while ((Get-Date) -lt $Deadline) {
        if (Test-TcpPort -HostName "127.0.0.1" -Port 9200) {
            Write-PipelineLog "OpenSearch SSH tunnel started successfully."
            return
        }

        Start-Sleep -Milliseconds 500
    }

    $TunnelError = ""

    if (Test-Path $TunnelErrorLog) {
        $TunnelError = (Get-Content $TunnelErrorLog -Raw -ErrorAction SilentlyContinue).Trim()
    }

    if (-not $TunnelError) {
        $TunnelError = "No SSH error output was captured."
    }

    throw "Unable to start OpenSearch tunnel. $TunnelError"
}

function Copy-LiveZeekLog {
    Write-PipelineLog "Copying Zeek log from ${ZeekUser}@${ZeekServer}:$ZeekRemoteLog"
    Remove-Item $TemporaryZeekLog -Force -ErrorAction SilentlyContinue

    # Build the remote source separately so PowerShell does not interpret
    # the colon after the server variable as part of the variable name.
    $RemoteSource = "{0}@{1}:{2}" -f $ZeekUser, $ZeekServer, $ZeekRemoteLog

    $ScpArguments = @(
        "-q",
        "-i", $SshKey,
        "-o", "BatchMode=yes",
        "-o", "IdentitiesOnly=yes",
        "-o", "ConnectTimeout=10",
        "-o", "StrictHostKeyChecking=accept-new",
        $RemoteSource,
        $TemporaryZeekLog
    )

    & scp.exe @ScpArguments
    $ExitCode = $LASTEXITCODE

    if ($ExitCode -ne 0) {
        Remove-Item $TemporaryZeekLog -Force -ErrorAction SilentlyContinue
        throw "Zeek SCP collection failed with exit code $ExitCode"
    }

    if (-not (Test-Path $TemporaryZeekLog) -or (Get-Item $TemporaryZeekLog).Length -eq 0) {
        Remove-Item $TemporaryZeekLog -Force -ErrorAction SilentlyContinue
        throw "The copied Zeek log is missing or empty"
    }

    Move-Item -Path $TemporaryZeekLog -Destination $LocalZeekLog -Force
    $Size = (Get-Item $LocalZeekLog).Length
    Write-PipelineLog "Zeek log updated successfully ($Size bytes)."
}

function Invoke-PythonStep {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Name,

        [Parameter(Mandatory = $true)]
        [string[]]$Arguments
    )

    Write-PipelineLog "Starting: $Name"

    $PreviousErrorActionPreference = $ErrorActionPreference
    $CommandOutput = @()
    $ExitCode = 1

    try {
        # Python logging normally writes INFO messages to stderr.
        # Do not let PowerShell treat those messages as terminating errors.
        $ErrorActionPreference = "Continue"

        $CommandOutput = & $PythonPath @Arguments 2>&1
        $ExitCode = $LASTEXITCODE
    }
    finally {
        $ErrorActionPreference = $PreviousErrorActionPreference
    }

    foreach ($OutputLine in $CommandOutput) {
        if ($ExitCode -eq 0) {
            Write-PipelineLog `
                -Level "INFO" `
                -Message "$OutputLine"
        }
        else {
            Write-PipelineLog `
                -Level "ERROR" `
                -Message "$OutputLine"
        }
    }

    if ($ExitCode -ne 0) {
        throw "$Name failed with exit code $ExitCode"
    }

    Write-PipelineLog "Completed: $Name"
}

    Write-PipelineLog "Starting: $Name"
    $CommandOutput = & $PythonPath @Arguments 2>&1
    $ExitCode = $LASTEXITCODE

    foreach ($OutputLine in $CommandOutput) {
        Write-PipelineLog "$OutputLine"
    }

    if ($ExitCode -ne 0) {
        throw "$Name failed with exit code $ExitCode"
    }

    Write-PipelineLog "Completed: $Name"
}

function Invoke-PipelineCycle {
    Start-IndexerTunnel

    Invoke-PythonStep `
        -Name "Wazuh live collection" `
        -Arguments @("src\wazuh_live_collector.py")

    Copy-LiveZeekLog

    Invoke-PythonStep `
        -Name "Zeek parsing" `
        -Arguments @("src\zeek_log_parser.py")

    Invoke-PythonStep `
        -Name "Contextual risk scoring" `
        -Arguments @("src\risk_engine.py")

    Invoke-PythonStep `
        -Name "OpenSearch publishing" `
        -Arguments @(
            "src\push_scored_events.py",
            "--index", $TargetIndex,
            "--refresh"
        )
}

try {
    Assert-RequiredFiles
    Set-Location $ProjectRoot

    Write-PipelineLog "Healthcare live pipeline started."
    Write-PipelineLog "Project root: $ProjectRoot"
    Write-PipelineLog "Execution interval: $IntervalSeconds seconds"

    while ($true) {
        $CycleStarted = Get-Date

        try {
            Write-PipelineLog "Beginning pipeline cycle."
            Invoke-PipelineCycle
            Write-PipelineLog "Pipeline cycle completed successfully."
        }
        catch {
            Write-PipelineLog -Level "ERROR" -Message $_.Exception.Message
        }

        $ElapsedSeconds = ((Get-Date) - $CycleStarted).TotalSeconds
        $SleepSeconds = [Math]::Max(
            1,
            $IntervalSeconds - [int][Math]::Ceiling($ElapsedSeconds)
        )

        Write-PipelineLog "Next cycle starts in $SleepSeconds second(s)."
        Start-Sleep -Seconds $SleepSeconds
    }
}
catch {
    Write-PipelineLog -Level "ERROR" -Message $_.Exception.Message
    exit 1
}